// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Producer {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String   @unique
  phone        String
  passwordHash String
  role         String   @default("producer") // producer / coordinator / admin
  subscription Subscription?
  programs     Program[]
  savedItems   SavedProgram[]
  inquiriesSent     Inquiry[] @relation("CoordinatorInquiries")
  inquiriesReceived Inquiry[] @relation("ProducerInquiries")
  createdAt    DateTime @default(now())
}

model Program {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String
  category    String
  targetAge   String
  duration    String
  location    String
  price       Float?
  phone       String?  // 👈 הוסף - טלפון ספציפי לתוכנית
  email       String?  // 👈 הוסף - אימייל ספציפי לתוכנית
  tags        String[]
  images      String[] @default([])
  videos      String[] @default([])
  status      String   @default("pending")
  views       Int      @default(0) // מונה צפיות לסטטיסטיקות
  producerId  String   @db.ObjectId
  producer    Producer @relation(fields: [producerId], references: [id])
  savedBy     SavedProgram[]
  inquiries   Inquiry[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Subscription {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  startDate     DateTime @default(now())
  expiryDate    DateTime
  status        String   @default("active") // active / expired / paused
  reminderSent  Boolean  @default(false)
  producerId    String   @unique @db.ObjectId
  producer      Producer @relation(fields: [producerId], references: [id])
}

// תוכנית שמורה של רכזת: מועדפים + הערה אישית + סטטוס מעקב
model SavedProgram {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  note          String?
  trackStatus   String   @default("saved") // saved / contacted / closed / irrelevant
  coordinatorId String   @db.ObjectId
  coordinator   Producer @relation(fields: [coordinatorId], references: [id], onDelete: Cascade)
  programId     String   @db.ObjectId
  program       Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([coordinatorId, programId])
}

// פנייה מרכזת (או גולשת אנונימית) אל מפיקה בנוגע לתוכנית
model Inquiry {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  message       String
  status        String    @default("new") // new / read / closed
  contactName   String
  contactPhone  String
  contactEmail  String?
  coordinatorId String?   @db.ObjectId
  coordinator   Producer? @relation("CoordinatorInquiries", fields: [coordinatorId], references: [id], onDelete: SetNull)
  programId     String    @db.ObjectId
  program       Program   @relation(fields: [programId], references: [id], onDelete: Cascade)
  producerId    String    @db.ObjectId
  producer      Producer  @relation("ProducerInquiries", fields: [producerId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
}
